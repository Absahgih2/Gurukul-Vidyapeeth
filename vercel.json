{
  "headers": [
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|gif|svg|ico|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin/assets/:path*", "destination": "/admin-panel/dist/assets/:path*" },
    { "source": "/admin", "destination": "/admin-panel/dist/index.html" },
    { "source": "/admin/", "destination": "/admin-panel/dist/index.html" },
    { "source": "/admin/:path*", "destination": "/admin-panel/dist/index.html" },
    { "source": "/uploads/:path*", "destination": "https://tucson-wallet-jacket-collectibles.trycloudflare.com/uploads/:path*" },
    { "source": "/api/:path*", "destination": "https://tucson-wallet-jacket-collectibles.trycloudflare.com/api/:path*" }
  ]
}
